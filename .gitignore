# Working roadmap — planning notes, not part of the deliverable
GHOSTGM_ROADMAP.md

# How to play a baseline session so the sample isn't lopsided. Working notes
# for the person at the keyboard, same as the roadmap.
playtest-guide.md

# Environment and API keys
.env
.env.*
*.key
*.pem
# A committed template is the point of it, so keep it out of the glob above.
!.env.example

# Session Transcripts. Raw play data — the input to phase 2's golden set, which
# does get committed, under evals/.
transcripts/

# Playtest arms. Same GM, different player and different reader; kept apart so
# the three failure logs stay independent samples. Local experiment scaffolding,
# not part of the deliverable.
gemini-transcripts/
gemini-failures.md
run_ai_session.py
run_batch_sessions.py
claude-transcripts/
claude-failures.md
run_claude_session.py

# Derived store. Rebuildable from transcripts/ by re-ingesting; never the
# source of truth for anything.
data/
*.db
*.db-wal
*.db-shm

# Python / Environment
venv/
.venv/
__pycache__/
*.pyc

# pytest writes a .gitignore inside its own cache, so this is already covered
# until that file is cleaned away. Say it here so it doesn't depend on that.
.pytest_cache/

# macOS
.DS_Store

# Per-machine editor/agent settings. Currently only ignored by this machine's
# global gitconfig, which doesn't travel with a clone.
.claude/settings.local.json
